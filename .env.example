# ==============================================================================
# Web Automation Configuration
# ==============================================================================
RAZORPAY_DEMO_URL=https://razorpay.com/demo/
WEB_BASE_URL=https://razorpay.com/demo/
SANDBOX_BASE_URL=https://razorpay.com/demo/
BROWSER=chromium
# Optional: set to 'chrome' or 'msedge' to use system-installed browser instead of Playwright Chromium
BROWSER_CHANNEL=
HEADLESS=false
DEFAULT_TIMEOUT_MS=15000

# ==============================================================================
# Payment & Checkout Test Data (Public Sandbox Defaults / Local .env Overrides)
# ==============================================================================
TEST_CARD_NUMBER=4111111111111111
TEST_CARD_EXPIRY=12/28
TEST_CARD_CVV=123
TEST_CARD_HOLDER=Test User
TEST_INVALID_CARD_NUMBER=4111111111111112
TEST_UPI_ID=success@razorpay
TEST_NETBANKING_BANK=HDFC
TEST_OTP_CODE=123456
SANDBOX_TEST_OTP=123456
OTP_POLL_TIMEOUT_SECONDS=30
ENABLE_LIVE_OTP_E2E=false
TEST_RECIPIENT_NAME=QA Test User
TEST_RECIPIENT_EMAIL=qa.test@example.com
TEST_RECIPIENT_MOBILE=9820098200
TEST_SENDER_NAME=QA Automation

# ==============================================================================
# Mobile / Appium (Android UiAutomator2) Configuration
# ==============================================================================
APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_UDID=
ANDROID_PLATFORM_VERSION=14.0
APP_PACKAGE=in.swiggy.android
APP_ACTIVITY=
APP_WAIT_ACTIVITY=in.swiggy.android.*
APK_PATH=
NO_RESET=true
AUTO_GRANT_PERMISSIONS=true
